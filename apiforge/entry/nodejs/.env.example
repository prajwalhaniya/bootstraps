PORT=3000
NODE_ENV=development
LOG_LEVEL=info

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# packages/gmail — credentials for a single default client (see its README
# for registering credentials for more than one clientId)
# GmailAppPasswordSender — https://myaccount.google.com/apppasswords
GMAIL_USER=
GMAIL_APP_PASSWORD=

# GmailApiSender — Google Cloud OAuth2 client + a refresh token
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER_EMAIL=
GMAIL_REDIRECT_URI=

# apps/invoice-reminder
INVOICE_REMINDER_INTERVAL_HOURS=4
# JSON: {"<clientId>": {"user": "notifications@example.com", "appPassword": "xxxx xxxx xxxx xxxx"}}
# clientId must match the "{clientId}_{file-name}.xlsx" prefix of each invoice file.
INVOICE_REMINDER_GMAIL_CREDENTIALS={}

# apps/book-tracker — override the default apps/book-tracker/data/books.db path, if needed
BOOK_TRACKER_DB_PATH=
# "Fill with AI" (vision LLM via instructor) — off until an API key below is set.
# "openai" | "gemini" | "custom" (any other OpenAI-compatible provider/model: Groq, Together,
# Anyscale, a local proxy, ...). Leave blank to auto-detect from whichever key is set below
# (checked in order: OPENAI_API_KEY, GEMINI_API_KEY, BOOK_TRACKER_AI_API_KEY).
BOOK_TRACKER_AI_PROVIDER=
# OpenAI — get a key at https://platform.openai.com/api-keys.
OPENAI_API_KEY=
# Gemini — get a key at https://aistudio.google.com/apikey. Used via Google's OpenAI-compatible
# endpoint, so the same instructor/openai code path serves both providers.
GEMINI_API_KEY=
# provider=custom only: the API key and endpoint for any other OpenAI-compatible provider.
BOOK_TRACKER_AI_API_KEY=
BOOK_TRACKER_AI_BASE_URL=
# Overrides the provider's default model (gpt-4o-mini for openai, gemini-3.8-flash for gemini;
# required for provider=custom, which has no default). Must be vision-capable either way, since
# it's sent the cover images directly.
BOOK_TRACKER_AI_MODEL=
