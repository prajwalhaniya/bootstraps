PORT=3000
NODE_ENV=development
LOG_LEVEL=info

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# packages/gmail — credentials for a single default client (see its README
# for registering credentials for more than one clientId)
# GmailAppPasswordSender — https://myaccount.google.com/apppasswords
GMAIL_USER=
GMAIL_APP_PASSWORD=

# GmailApiSender — Google Cloud OAuth2 client + a refresh token
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER_EMAIL=
GMAIL_REDIRECT_URI=

# apps/invoice-reminder
INVOICE_REMINDER_INTERVAL_HOURS=4
# JSON: {"<clientId>": {"user": "notifications@example.com", "appPassword": "xxxx xxxx xxxx xxxx"}}
# clientId must match the "{clientId}_{file-name}.xlsx" prefix of each invoice file.
INVOICE_REMINDER_GMAIL_CREDENTIALS={}
